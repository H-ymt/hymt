---
import EntryCard from "./EntryCard.astro";
import { ITEMS_PER_PAGE } from "../lib/constants";
import type { KnowledgeEntry } from "../lib/types";

interface Props {
  initialEntries: KnowledgeEntry[];
  hasMore: boolean;
}

const { initialEntries, hasMore } = Astro.props;
---

{
  initialEntries.length === 0 ? (
    <div class="empty">
      <p>記事がありません。</p>
      <p class="empty-sub">
        entries.jsonを生成するには、fetch-knowledgeスクリプトを実行してください。
      </p>
    </div>
  ) : (
    <section class="section">
      <ul
        class="entry-list"
        id="entry-list"
        data-has-more={hasMore ? "true" : "false"}
        data-page="1"
        data-items-per-page={ITEMS_PER_PAGE}
      >
        {initialEntries.map((entry: KnowledgeEntry) => (
          <EntryCard entry={entry} />
        ))}
      </ul>
      <div id="observer-target" class="observer-target">
        <div id="loading-container" class="loading-container" hidden>
          <svg
            class="spinner"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" opacity="0.25" />
            <path
              d="M12 2a10 10 0 0 1 10 10"
              opacity="0.75"
              stroke-dasharray="31.416"
              stroke-dashoffset="31.416"
            >
              <animate
                attributeName="stroke-dashoffset"
                dur="1.5s"
                values="31.416;0"
                repeatCount="indefinite"
              />
            </path>
          </svg>
          <p class="loading">読み込み中...</p>
        </div>
      </div>
    </section>
  )
}

<script>
  const list = document.getElementById("entry-list") as HTMLUListElement | null;
  const target = document.getElementById("observer-target");
  const loadingContainer = document.getElementById("loading-container");

  if (list && target) {
    // 非 null の絞り込みは async な loadMore のクロージャ内までは保持されないため、
    // ここで束縛し直して以降は entryList / observerTarget を使う。
    const entryList = list;
    const observerTarget = target;
    let page = parseInt(entryList.dataset.page ?? "1", 10);
    let hasMore = entryList.dataset.hasMore === "true";
    let isFetching = false;
    const itemsPerPage = parseInt(entryList.dataset.itemsPerPage ?? "10", 10);

    async function loadMore() {
      if (!hasMore || isFetching) return;
      isFetching = true;
      if (loadingContainer) loadingContainer.hidden = false;

      try {
        const nextPage = page + 1;
        const res = await fetch(`/api/entries?page=${nextPage}&limit=${itemsPerPage}`);
        if (!res.ok) throw new Error("Failed to fetch");

        entryList.insertAdjacentHTML("beforeend", await res.text());

        page = nextPage;
        hasMore = res.headers.get("X-Has-More") === "true";
        if (!hasMore) {
          observer.disconnect();
          observerTarget.hidden = true;
        }
      } catch (e) {
        console.error(e);
      } finally {
        isFetching = false;
        if (loadingContainer) loadingContainer.hidden = true;
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0]?.isIntersecting) loadMore();
      },
      { threshold: 0.8 },
    );

    if (hasMore) observer.observe(observerTarget);
  }
</script>

<style>
  .section {
    margin-block-start: 2rem;
  }

  .empty {
    padding-block: 4rem;
    color: var(--foreground-muted);
    text-align: center;
  }

  .empty-sub {
    margin-block-start: 0.5rem;
    font-size: 0.875rem;
  }

  .entry-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    list-style: none;
  }

  @media screen and (width <= 48rem) {
    .entry-list {
      gap: 1.5rem;
    }
  }

  .observer-target {
    padding-block: 2rem;
    margin-block-start: 2rem;
    text-align: center;
  }

  .loading-container:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
  }

  .spinner {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--foreground-muted);
    animation: spin 1.5s linear infinite;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .loading {
    font-size: 0.875rem;
    color: var(--foreground-muted);
  }
</style>
