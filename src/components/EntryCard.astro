---
import ExternalLinkIcon from "./ExternalLinkIcon.astro";
import SourceIcon from "./SourceIcon.astro";
import { formatDate } from "../lib/utils/format-date";
import type { KnowledgeEntry, Tag } from "../lib/types";

interface Props {
  entry: KnowledgeEntry;
}

const { entry } = Astro.props;
---

<li class="entry-item">
  <article class="entry">
    <header class="entry-header">
      <div class="entry-meta">
        <time class="entry-date" datetime={entry.publishedAt}>
          {formatDate(entry.publishedAt)}
        </time>
      </div>
      <h2 class="entry-title">
        <span class="entry-source">
          <SourceIcon source={entry.source} />
        </span>
        <a href={entry.url} target="_blank" rel="noopener noreferrer" class="entry-link">
          {entry.title}
          <ExternalLinkIcon />
        </a>
      </h2>
    </header>
    {entry.summary && <p class="entry-summary">{entry.summary}</p>}
    {
      entry.tags.length > 0 && (
        <ul class="tag-list">
          {entry.tags.map((tag: Tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )
    }
  </article>
</li>

<style>
  .entry-item {
    padding-block-end: 2rem;
    border-bottom: 0.0313rem solid var(--border);
  }

  .entry-item:last-child {
    border-bottom: none;
  }

  .entry {
    display: flex;
    flex-direction: column;
    gap: 0.325rem;
  }

  .entry-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .entry-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.875rem;
    color: var(--foreground-muted);
  }

  .entry-date {
    font-size: 0.875rem;
  }

  .entry-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
  }

  .entry-source {
    margin-block-start: 0.15em;
    margin-inline-end: 0.375rem;
    display: inline-block;
    vertical-align: middle;
  }

  .entry-link {
    color: var(--foreground);
    text-decoration: none;
  }

  .entry-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.0625rem;
    text-underline-offset: 0.15em;
    text-decoration-color: color-mix(in srgb, var(--foreground) 40%, transparent);
  }

  .entry-link :global(.external-icon) {
    width: 0.6875rem;
    height: 0.6875rem;
    margin-inline-start: 0.35rem;
    margin-block-end: 0.15em;
    vertical-align: middle;
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .entry-link:hover :global(.external-icon) {
    opacity: 1;
  }

  .entry-summary {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--foreground-muted);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    list-style: none;
  }

  .tag {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    font-size: 0.75rem;
    color: var(--foreground-muted);
    background-color: var(--border);
    border-radius: 0.25rem;
  }

  @media screen and (width <= 48rem) {
    .entry-item {
      padding-block-end: 1.5rem;
    }
  }
</style>
