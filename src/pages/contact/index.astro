---
import Container from "../../components/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact - Yamato Handai" description="Feel free to reach out via the contact form.">
  <Container type="page">
    <h1 class="pageTitle">Contact</h1>
    <p class="pageDescription">Feel free to reach out. I'll get back to you as soon as possible.</p>

    <div id="successMessage" class="message success" role="status" aria-live="polite" hidden>
      Your message has been sent. Thank you for reaching out!
    </div>
    <div id="errorMessage" class="message error" role="alert" aria-live="assertive" hidden></div>

    <form id="contactForm" class="form" novalidate>
      <div class="field">
        <label for="name" class="label">Name</label>
        <input type="text" id="name" name="name" class="input" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="email" class="label">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          class="input"
          autocomplete="email"
          required
        />
      </div>
      <div class="field">
        <label for="message" class="label">Message</label>
        <textarea id="message" name="message" class="textarea" rows="6" required></textarea>
      </div>
      <div class="turnstile">
        <div
          class="cf-turnstile"
          data-sitekey="0x4AAAAAADOGZc4W0EQsUR38"
          data-theme="auto"
        ></div>
      </div>
      <button type="submit" id="submitBtn" class="button">Submit</button>
    </form>

    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    ></script>
  </Container>
</BaseLayout>

<script>
  const form = document.getElementById("contactForm") as HTMLFormElement | null;
  const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement | null;
  const successMessage = document.getElementById("successMessage") as HTMLElement | null;
  const errorMessage = document.getElementById("errorMessage") as HTMLElement | null;

  if (!form || !submitBtn || !successMessage || !errorMessage) {
    console.warn("Contact form: required elements not found.");
    throw new Error("Contact form elements not found");
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    successMessage.hidden = true;
    errorMessage.hidden = true;
    submitBtn.disabled = true;
    submitBtn.textContent = "Sending...";

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        body: new FormData(form),
      });

      const json = await res.json();

      if (json.success) {
        successMessage.hidden = false;
        form.hidden = true;
      } else {
        // @ts-ignore
        if (window.turnstile) window.turnstile.reset();

        errorMessage.textContent = json.error ?? "Something went wrong. Please try again later.";
        errorMessage.hidden = false;
      }
    } catch {
      // @ts-ignore
      if (window.turnstile) window.turnstile.reset();
      errorMessage.textContent = "Something went wrong. Please try again later.";
      errorMessage.hidden = false;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Send";
    }
  });
</script>

<style>
  .pageTitle {
    margin-block-end: 0.75em;
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--foreground);
  }

  .pageDescription {
    font-size: 0.9375rem;
    color: var(--foreground-muted);
  }

  .message {
    margin-block-start: 1.5rem;
    padding: 0.75rem 1rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .message.success {
    background: color-mix(in srgb, #22c55e 14%, var(--background));
    color: #15803d;
  }

  .message.error {
    background: color-mix(in srgb, #ef4444 14%, var(--background));
    color: #b91c1c;
  }

  @media (prefers-color-scheme: dark) {
    .message.success {
      background: color-mix(in srgb, #4ade80 16%, var(--background));
      color: #86efac;
    }

    .message.error {
      background: color-mix(in srgb, #f87171 16%, var(--background));
      color: #fca5a5;
    }
  }

  .form {
    display: grid;
    gap: 1.75rem;
    margin-block-start: 2.5rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  .label {
    font-size: 0.875rem;
    color: var(--foreground);
  }

  .input,
  .textarea {
    width: 100%;
    padding: 0.625rem 0.875rem;
    font-size: 0.9375rem;
    font-family: inherit;
    color: var(--foreground);
    background: var(--background);
    border: 0.0625rem solid var(--border);
    border-radius: 0.375rem;
    outline: none;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }

  .input:focus-visible,
  .textarea:focus-visible {
    border-color: color-mix(in srgb, var(--foreground) 24%, transparent);
    box-shadow: 0 0 1px 0.1875rem color-mix(in srgb, var(--foreground) 12%, transparent);
  }

  .textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .turnstile {
    margin-block: -0.25rem;
  }

  .button {
    justify-self: start;
    padding: 0.625rem 1.5rem;
    font-size: 0.875rem;
    font-family: inherit;
    color: var(--background);
    background: var(--foreground);
    border: none;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: background 0.15s;
  }

  .button:hover:not(:disabled) {
    background: color-mix(in srgb, var(--foreground) 88%, var(--background));
  }

  .button:focus-visible {
    outline: 0.125rem solid var(--foreground);
    outline-offset: 0.125rem;
  }

  .button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
